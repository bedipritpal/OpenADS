+/* Report known write failures without automatic replay/default. Unknown
+ * navigation/append errors retain their original compatibility flags. */
+static HB_ERRCODE adsCheckedWriteResult( ADSAREAP pArea, UNSIGNED32 code,
+                                        HB_ERRCODE fallback )
+{
+   HB_ERRCODE gen = fallback;
+   HB_USHORT flags = fallback == EG_CORRUPTION ? EF_CANDEFAULT : 0;
+   HB_BOOL knownWrite = HB_TRUE;
+   if( code == AE_SUCCESS )
+      return HB_SUCCESS;
+   if( code == AE_LOCK_FAILED || code == AE_RECORD_NOT_LOCKED )
+      gen = EG_UNLOCKED;
+   else if( code == AE_TABLE_READONLY )
+      gen = EG_READONLY;
+   else if( code == 5063 /* OpenADS AE_COLUMN_NOT_FOUND */ )
+      gen = EG_WRITE;
+   else if( code == AE_DATA_TOO_LONG
+#ifdef AE_VALUE_OVERFLOW
+            || code == AE_VALUE_OVERFLOW
+#endif
+          )
+      gen = EG_DATAWIDTH;
+   else
+      knownWrite = HB_FALSE;
+   if( knownWrite )
+      flags = 0;
+   commonError( pArea, gen, ( HB_ERRCODE ) code, 0, NULL, flags, NULL );
+   return HB_FAILURE;
+}
